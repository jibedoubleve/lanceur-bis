<Page
    x:Class="Lanceur.Ui.WPF.Views.Pages.DataSourcesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:constants="clr-namespace:Lanceur.Core.Constants;assembly=Lanceur.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Self"
    Title="Data sources"
    d:Width="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Lanceur.Ui.WPF;component/Xaml/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:Array x:Key="Browsers" Type="{x:Type sys:String}">
                <sys:String>Firefox</sys:String>
                <sys:String>Zen</sys:String>
                <sys:String>Chrome</sys:String>
                <sys:String>Edge</sys:String>
            </x:Array>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,15">
            <!--  DATABASE  -->
            <ui:TextBlock Style="{StaticResource SettingSection}" Text="Database" />

            <ui:CardControl Icon="{ui:SymbolIcon Database24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Database file" />
                        <ui:TextBlock Style="{StaticResource SettingDescription}"
                                      Text="SQLite file that stores the aliases and the history. Requires a restart." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox MinWidth="500" Text="{Binding DbPath}" />
                    <ui:Button
                        Margin="5,0,0,0"
                        Click="OnClickDbPath"
                        Content="Browse…" />
                </StackPanel>
            </ui:CardControl>

            <!--  BOOKMARKS  -->
            <ui:TextBlock Style="{StaticResource SettingSection}" Text="Bookmarks" />

            <ui:CardControl Icon="{ui:SymbolIcon BookmarkSearch24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Bookmarks browser" />
                        <ui:TextBlock Style="{StaticResource SettingDescription}"
                                      Text="Browser whose bookmarks are searched." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{StaticResource Browsers}"
                          SelectedItem="{Binding BookmarkSourceBrowser}" />
            </ui:CardControl>

            <!--  EVERYTHING  -->
            <ui:TextBlock Style="{StaticResource SettingSection}" Text="Everything" />

            <ui:CardControl Icon="{ui:SymbolIcon SlideHide24}">
                <ui:CardControl.Header>
                    <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Exclude hidden files" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ExcludeHiddenFilesWithEverything}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ShieldKeyhole24}">
                <ui:CardControl.Header>
                    <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Exclude system files" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ExcludeSystemFilesWithEverything}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Run24}">
                <ui:CardControl.Header>
                    <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Executable files only" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IncludeOnlyExecFilesWithEverything}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Delete24}">
                <ui:CardControl.Header>
                    <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Exclude files in the Recycle Bin" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ExcludeFilesInBinWithEverything}" />
            </ui:CardControl>

            <!--  STEAM  -->
            <ui:TextBlock Style="{StaticResource SettingSection}" Text="Steam" />

            <ui:CardControl
                DataContext="{Binding FeatureFlags, Converter={StaticResource FeatureFlagByNameConverter}, ConverterParameter={x:Static constants:Features.SteamIntegration}}"
                Icon="{ui:SymbolIcon Games24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Search Steam library" />
                        <ui:TextBlock Style="{StaticResource SettingDescription}"
                                      Text="Browse and launch the games installed in the Steam library." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Enabled}" />
            </ui:CardControl>

            <!--  SHORTCUT OVERRIDES  -->
            <ui:TextBlock Style="{StaticResource SettingSection}" Text="Shortcut overrides" />

            <ui:CardExpander Icon="{ui:SymbolIcon ArrowUpRight24}" IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource SettingTitle}" Text="Store shortcuts" />
                        <ui:TextBlock Style="{StaticResource SettingDescription}"
                                      Text="Special character typed at the start of a query to search a store directly." />
                    </StackPanel>
                </ui:CardExpander.Header>

                <ui:DataGrid
                    AreRowDetailsFrozen="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="True"
                    ItemsSource="{Binding StoreShortcuts}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="Auto" Header="Store name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding StoreType, Converter={StaticResource StoreTypeToStoreNameConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
    
                        <DataGridTemplateColumn Width="*" Header="Shortcut override">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding AliasOverride, Converter={StaticResource StoreOrchestrationToStringConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
    
                        <DataGridTemplateColumn Width="100" Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            Command="{Binding ElementName=Self, Path=DataContext.EditStoreShortcutCommand}"
                                            CommandParameter="{Binding .}"
                                            ToolTip="Edit">
                                            <ui:SymbolIcon Symbol="Edit24" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
